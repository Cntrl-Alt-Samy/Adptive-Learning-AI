# LearnOS environment — copy to .env and fill in. NEVER commit the real .env.

# Supabase PostgreSQL
# Pooled (Supavisor transaction mode) for runtime access:
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (:5432) for migrations:
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Redis (Upstash prod / local compose redis://localhost:6379)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=learnos-curriculum-rag

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# LLM gateway (OpenCode Zen)
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://opencode.ai/zen/v1
ANTHROPIC_API_KEY=
LEARNOS_TUTOR_MODEL=x-preview-f-free

# Local integration tests (optional; falls back to DIRECT_URL)
TEST_DATABASE_URL=
TEST_REDIS_URL=
