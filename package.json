{
  "name": "learnos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "LearnOS — Adaptive AI Tutor Platform (Sprint 0: Foundations & Tooling)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:web": "vitest run tests/web",
    "test:unit": "vitest run tests/unit tests/e2e",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "ingest:dry": "tsx scripts/ingest-curriculum.ts --validate-dag",
    "ingest": "tsx scripts/ingest-curriculum.ts",
    "pinecone:init": "tsx scripts/init-pinecone.ts",
    "pinecone:seed": "tsx scripts/seed-pinecone.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "evals:golden": "tsx scripts/run-golden-evals.ts",
    "migrations:verify": "tsx scripts/check-migrations.ts",
    "smoke:ga": "tsx scripts/ga-smoke.ts",
    "syllabus:ingest:dry": "tsx scripts/ingest-syllabus.ts --dry-run",
    "syllabus:ingest": "tsx scripts/ingest-syllabus.ts"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^6.1.2",
    "@prisma/client": "^6.16.2",
    "@trpc/server": "^11.18.0",
    "bullmq": "^5.58.5",
    "dotenv": "^17.2.2",
    "ioredis": "^5.8.0",
    "katex": "^0.18.4",
    "next": "^15.5.23",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "fast-check": "^4.3.0",
    "happy-dom": "^20.11.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
