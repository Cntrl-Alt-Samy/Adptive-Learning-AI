{
  "name": "learnos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "LearnOS — Adaptive AI Tutor Platform (Sprint 0: Foundations & Tooling)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/e2e",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "ingest:dry": "tsx scripts/ingest-curriculum.ts --validate-dag",
    "ingest": "tsx scripts/ingest-curriculum.ts",
    "pinecone:init": "tsx scripts/init-pinecone.ts",
    "pinecone:seed": "tsx scripts/seed-pinecone.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "evals:golden": "tsx scripts/run-golden-evals.ts"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^6.1.2",
    "@prisma/client": "^6.16.2",
    "@trpc/server": "^11.18.0",
    "bullmq": "^5.58.5",
    "dotenv": "^17.2.2",
    "ioredis": "^5.8.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.3.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
